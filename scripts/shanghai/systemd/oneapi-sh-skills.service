[Unit]
Description=Refresh the Shanghai Semifly Skills market snapshot
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=oneapi-skills
Group=oneapi-skills
WorkingDirectory=/srv/oneapi-data/oneapi-skills-runtime
ExecStart=/usr/bin/python3 /srv/oneapi-data/oneapi-skills-runtime/scripts/update-market.py --output /srv/oneapi-data/oneapi-skills-data/market-data.json
TimeoutStartSec=10min
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/oneapi-data/oneapi-skills-data
